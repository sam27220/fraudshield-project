<%- include("partials/header", { title: "Alerts | FraudShield AI" }) %>
<h1 class="h3 mb-3">Investigation alerts</h1>
<div class="card"><div class="card-body"><% if (!alerts.length) { %><p>No alerts.</p><% } else { %>
<% alerts.forEach(a => { %><div class="alert alert-warning d-flex justify-content-between align-items-center"><div><strong><%= a.id %></strong> — <%= a.from %> → <%= a.to %><br><small>Amount: ₹<%= a.amount.toLocaleString("en-IN") %></small></div><span class="badge text-bg-danger">Risk <%= a.score %></span></div><% }) %>
<% } %></div></div>
<%- include("partials/footer") %>
